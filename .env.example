# Public site URL used for canonical URLs, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.nudgeable.ai

# Required to load the two public YouTube playlists on the Insights page.
# Keep this server-side. Do not prefix it with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
YOUTUBE_SHORTS_PLAYLIST_ID=https://www.youtube.com/playlist?list=PLX2kcOVk5064
YOUTUBE_WORKFLOWS_PLAYLIST_ID=https://www.youtube.com/playlist?list=PLWrY3kWovqrDc2XMO3kj66fqMCPwAl4_v

# Optional demo video links.
NEXT_PUBLIC_PRACTICE_LAB_DEMO_URL=
NEXT_PUBLIC_SALES_COACH_DEMO_URL=
NEXT_PUBLIC_LEADERSHIP_COACH_DEMO_URL=

# Required for the contact form. Create a key at https://resend.com/api-keys
# Enquiry emails are sent to team@nudgeable.ai, egauravpatel@gmail.com, and work.nudgeable@gmail.com.
RESEND_API_KEY=

# Verified sender in Resend (nudgeable.app domain).
CONTACT_FROM_EMAIL=Nudgeable <team@nudgeable.app>

# Optional analytics and Search Console verification.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Required to publish blogs from /insights/blogs/write
ADMIN_PASSWORD=

# Required for blogs. Create a project at https://supabase.com, run supabase/schema.sql
# in the SQL editor, then paste the project URL and service role key here.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
