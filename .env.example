# Public site URL used for canonical URLs, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.nudgeable.ai

# Required to load the two public YouTube playlists on the Insights page.
# Keep this server-side. Do not prefix it with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
YOUTUBE_SHORTS_PLAYLIST_ID=https://www.youtube.com/playlist?list=PLX2kcOVk5064
YOUTUBE_WORKFLOWS_PLAYLIST_ID=https://www.youtube.com/playlist?list=PLWrY3kWovqrDc2XMO3kj66fqMCPwAl4_v

# Optional demo video links.
NEXT_PUBLIC_PRACTICE_LAB_DEMO_URL=
NEXT_PUBLIC_SALES_COACH_DEMO_URL=
NEXT_PUBLIC_LEADERSHIP_COACH_DEMO_URL=

# Optional form endpoint, such as Formspree or a private API route.
# Without this, the form opens a pre-filled email to team@nudgeable.ai.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional analytics and Search Console verification.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
